# Every setting SEO Hub needs. Copy to .env.local (never commit it) and fill in.
# On Vercel, add the same names under Project Settings → Environment Variables.
# Never put real values in this file: it is committed to GitHub.

# Supabase: the SAME project as Visual Vibe HQ (copy both from HQ's .env.local).
# Server only, never in the browser. SEO tables are kept separate from HQ's (seo_ prefix), RLS on all.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in (phase 1): same team password as HQ.
# SESSION_SECRET must be the SAME value as HQ's so HQ's vv_session cookie is valid here too.
# TEAM_PASSWORD_HASH: only a fallback; the live hash is read from Supabase (team_password_hash), like HQ.
SESSION_SECRET=
TEAM_PASSWORD_HASH=

# Shared login across apps (later, once custom domains exist), e.g. .visualvibedesign.com
# Leave empty until Alexia confirms the domains.
SESSION_COOKIE_DOMAIN=

# HQ's address for the sidebar's "Switch app" button (opens HQ's /apps). Public, not a secret.
# Not set: http://localhost:5173 in npm run dev, https://visual-vibe-dashboard.vercel.app in builds.
# Set it once HQ moves to its custom domain (e.g. https://hq.visualvibedesign.com).
VITE_HQ_URL=
