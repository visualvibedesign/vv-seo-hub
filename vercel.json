{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/auth/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/autofill/*.ts": {
      "maxDuration": 300
    },
    "api/imports/*.ts": {
      "maxDuration": 120
    },
    "api/metrics/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/metrics/cron",
      "schedule": "0 9 * * *"
    }
  ]
}
